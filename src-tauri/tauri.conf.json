{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1430",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Wolf Timeline",
    "version": "1.0.0-alpha.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "open": true },
      "dialog": { "save": true },
      "notification": { "all": true }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.wolfitway.wolftimeline",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: asset: http://asset.localhost;"
    },
    "windows": [
      {
        "title": "Wolf Timeline",
        "width": 1180,
        "height": 780,
        "resizable": true
      }
    ]
  }
}
